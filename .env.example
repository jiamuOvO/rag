RAG_DATA_DIR=F:\RAG\Li_Jia\data
RAG_VAR_DIR=F:\RAG\Li_Jia\var
RAG_CHAT_PROVIDER=extractive
# OpenAI-compatible provider only:
# RAG_CHAT_PROVIDER=openai_compatible
# RAG_CHAT_BASE_URL=https://example.com/v1
# RAG_CHAT_API_KEY=replace-me
# RAG_CHAT_MODEL=replace-me
# RAG_CHAT_TIMEOUT_SECONDS=60
RAG_DEBUG=0
RAG_OCR_ENABLED=1
RAG_MIN_PAGE_CHARS=80
# Generate interactively with: python -m rag.cli hash-password
RAG_ADMIN_PASSWORD_HASH=
# Generate a long random value with your deployment secret manager.
RAG_SESSION_SECRET=
RAG_SESSION_TTL_SECONDS=28800
RAG_COOKIE_SECURE=0
RAG_RERANKER_PROVIDER=disabled
RAG_STRUCTURED_EXTRACTION_ENABLED=0
